{{- $p := site.Data.profile -}}
{{- $pages := .RegularPages -}}
{{- if .IsHome -}}
  {{- with site.GetPage "/posts" -}}
    {{- $pages = .RegularPagesRecursive -}}
  {{- end -}}
{{- else if eq .Kind "section" -}}
  {{- $nested := .RegularPagesRecursive -}}
  {{- if gt (len $nested) (len .RegularPages) }}{{ $pages = $nested }}{{ end -}}
{{- end -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ $p.name }}{{ else }}{{ .Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ if .IsHome }}{{ $p.description | htmlEscape }}{{ else }}{{ printf "%s — %s" .Title $p.name | htmlEscape }}{{ end }}</description>
    <language>{{ site.LanguageCode }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title | htmlEscape }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{- if not .Date.IsZero }}
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      {{- end }}
      <author>{{ $p.email }} ({{ $p.name }})</author>
      <description>{{ .Summary | plainify | htmlEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
